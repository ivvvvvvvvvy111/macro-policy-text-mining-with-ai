LLM_PROVIDER=siliconflow
SILICONFLOW_API_KEY=your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Cheap model for measure split + routing
SILICONFLOW_MODEL_MEASURE=Qwen/Qwen3.5-9B
SILICONFLOW_MODEL_ROUTING=Qwen/Qwen3.5-9B

# Mid model for relation scoring
SILICONFLOW_MODEL_SCORING=Qwen/Qwen3.5-35B-A3B

LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS_MEASURE=2500
LLM_MAX_TOKENS_ROUTING=2000
LLM_MAX_TOKENS_SCORING=6000
