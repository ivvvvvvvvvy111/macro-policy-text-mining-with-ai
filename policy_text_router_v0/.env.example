LLM_PROVIDER=siliconflow
SILICONFLOW_API_KEY=your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.5-35B-A3B
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2500

# PostgreSQL + pgvector
POSTGRES_DB=policy_router
POSTGRES_USER=policy_router
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://policy_router:change-me-before-production@localhost:5432/policy_router
